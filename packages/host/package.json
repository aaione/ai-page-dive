{
  "name": "@aaione/ai-page-dive",
  "version": "0.1.1",
  "description": "PageDive native messaging host — 零依赖薄壳，桥接 Chrome 扩展与本机 AI CLI（claude / codex）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ai-page-dive": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "builtins",
    "builtins-skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.json",
    "postinstall": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('dist/scripts/postinstall.js'))cp.spawnSync(process.execPath,[require('path').resolve('dist/scripts/postinstall.js')],{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@ai-page-dive/shared": "workspace:*"
  }
}
