{
  "name": "@ai-page-dive/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch",
    "build:e2e": "E2E_BROAD_PERMS=1 vite build --outDir dist-e2e && E2E_BROAD_PERMS=1 vite build --config vite.content.config.ts --outDir dist-e2e --emptyOutDir false"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@ai-page-dive/shared": "workspace:*",
    "dompurify": "^3.4.14",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4"
  }
}