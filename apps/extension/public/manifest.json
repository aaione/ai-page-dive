{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "AI PageDive",
  "version": "0.1.3",
  "key": "",
  "description": "用你已登录的 Claude/Codex 订阅深度总结网页——免费、无 API key、正文不经服务器。Deep-summarize any page with your own Claude/Codex CLI subscription.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "PageDive 深度总结",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+I"
      },
      "description": "总结当前页"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}